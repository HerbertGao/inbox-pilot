# ── P0 必需 ──────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# 宿主侧 dev / migrate 用 localhost 形态（宿主命令一律用 localhost）。
# docker compose 下由 app(inbox-pilot) 服务以环境变量覆盖为 @postgres:5432。
DATABASE_URL=postgresql://mail_router:mail_router_password@localhost:5432/mail_router

# ── 以下为后续阶段（P1–P6）变量，P0 可选、留空占位 ───────────
# OpenRouter（P1 AI 分类内核）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=inbox-pilot

# Gmail（P4 接入）
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/oauth/gmail/callback

# Telegram 通知（P2）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bark 通知（P2）
BARK_ENDPOINT=

# IMAP 账号（P3）：可选 provider。缺 IMAP_HOST 即不启用 IMAP 轮询、服务正常启动。
# IMAP_HOST 已设而 IMAP_USER/IMAP_PASSWORD 缺失 → accountService fail-fast 配置错误。
# IMAP_PASSWORD 只从环境变量读、禁写死、不入日志。IMAP_ACCOUNT_ID 留空时确定性派生
# imap:<user>@<host>（含 user、会进日志，要干净 id 就显式设 IMAP_ACCOUNT_ID）。
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_ACCOUNT_ID=

# 轮询（P3/P4）与摘要（P5）
POLL_INTERVAL_SECONDS=180
DIGEST_TIMES=12:30,21:30
