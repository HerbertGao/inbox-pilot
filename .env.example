# ── P0 必需 ──────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# 宿主侧 dev / migrate 用 localhost 形态（宿主命令一律用 localhost）。
# docker compose 下由 app(inbox-pilot) 服务以环境变量覆盖为 @postgres:5432。
DATABASE_URL=postgresql://mail_router:mail_router_password@localhost:5432/mail_router

# ── 以下为后续阶段（P1–P6）变量，P0 可选、留空占位 ───────────
# OpenRouter（P1 AI 分类内核）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=inbox-pilot

# Gmail（P4 接入）：app 凭据，从 env 读（账号凭据存 DB MailAccount.authJson）。
# GMAIL_REDIRECT_URI 仅约定 host/path——端口运行时绑定空闲端口后填入（Desktop-app
# loopback client 无需 GCP 预注册具体端口）；host 必须为 127.0.0.1（禁 localhost/[::1]）、
# path 必须为 /oauth2/callback，否则 Gmail onboarding 显式失败（其余服务照常启动）。
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1/oauth2/callback

# Telegram 通知（P2）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bark 通知（P2）
BARK_ENDPOINT=

# 账号（IMAP / Gmail）凭据不走 env——统一存 DB MailAccount.authJson。
# 加账号：`pnpm account add --imap` / `pnpm account add --gmail`（凭据走交互 prompt、不经 argv）。
# 查看 / 停用：`pnpm account list` / `pnpm account disable <id>`。

# 轮询（P3/P4）与摘要（P5）
POLL_INTERVAL_SECONDS=180
DIGEST_TIMES=12:30,21:30
# 容器时区：每日摘要定点触发（DIGEST_TIMES）依赖时区；docker compose 随 .env 透传给 inbox-pilot 服务。
TZ=Asia/Shanghai

# 规则名单文件（可选）：覆盖默认 rules/rules.yaml 路径；不设则用仓库内默认。
# 改文件即生效（mtime 轮询热重载）。缺失/非法逐项回落、护栏不失效。
# RULES_FILE=
