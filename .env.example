# ── P0 必需 ──────────────────────────────────────────────
# 一律 localhost 形态：pilot（hangar 原生进程）与宿主侧 migrate/dev 都经 compose 发布的
# loopback 端口连库（端口随 POSTGRES_HOST_PORT；线上是 5433）。
DATABASE_URL=postgresql://mail_router:mail_router_password@localhost:5432/mail_router

# ── 以下为后续阶段（P1–P6）变量，P0 可选、留空占位 ───────────
# OpenRouter（P1 AI 分类内核）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=inbox-pilot

# Gmail（P4 接入）：app 凭据，从 env 读（账号凭据存 DB MailAccount.authJson）。
# GMAIL_REDIRECT_URI 仅约定 host/path——端口运行时绑定空闲端口后填入（Desktop-app
# loopback client 无需 GCP 预注册具体端口）；host 必须为 127.0.0.1（禁 localhost/[::1]）、
# path 必须为 /oauth2/callback，否则 Gmail onboarding 显式失败（其余服务照常启动）。
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1/oauth2/callback

# 通知（telegram）的 bot token 走 env，但**变量名不固定**——由 hangar 的 channels.yaml 指名。
# 它与 channels.yaml 任一缺失都会**静默**失去通知能力（doctor 仍返回 0）。
# 配置方式与排查手段见 docs/DEPLOY.md「通知凭据来源」，那里是唯一权威。

# 账号（IMAP / Gmail）凭据不走 env——统一存 DB MailAccount.authJson。
# 加账号：`pnpm account add --imap` / `pnpm account add --gmail`（凭据走交互 prompt、不经 argv）。
# 查看 / 停用：`pnpm account list` / `pnpm account disable <id>`。

# 进程时区（daemon 启动时读入）：未设 / 为空时应用回退 Asia/Shanghai 并发一次性 tz-fallback-default 告警。
TZ=Asia/Shanghai

# 规则名单文件（可选）：覆盖默认 rules/rules.yaml 路径；不设则用仓库内默认。
# 改 RULES_FILE（读哪个文件路径）是 env 形态、需重启 daemon 才生效；改 rules.yaml 文件「内容」
# 属文件形态（热重载语义与已知缺口见 docs/DEPLOY.md）。缺失/非法逐项回落、护栏不失效。
# RULES_FILE=

# postgres 宿主端口覆盖（可选，多主机/避端口冲突用）：
#   POSTGRES_HOST_PORT —— postgres 容器映射到宿主 loopback 的端口（默认 5432；线上 mac-mini 用 5433）。
# 改它要同步改上面 DATABASE_URL 的端口。
# POSTGRES_HOST_PORT=5432
