{
  "name": "inbox-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@10.28.2",
  "bin": {
    "inbox-pilot": "dist/cli/inbox-pilot.js"
  },
  "scripts": {
    "account": "tsx src/cli/account.ts",
    "build": "tsc",
    "test": "tsx --test 'src/**/*.test.ts'",
    "eval:phishing": "tsx src/classifier/eval/run.ts --suite phishing",
    "eval:false-positive": "tsx src/classifier/eval/run.ts --suite false-positive",
    "test:tz": "TZ=Asia/Shanghai tsx --test 'src/cli/processFromDate.test.ts' 'src/cli/account.test.ts'",
    "test:tz-utc": "TZ=UTC tsx --test 'src/cli/processFromDate.test.ts' 'src/cli/account.test.ts'",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@herbertgao/hangar-notify": "^0.2.0",
    "@prisma/client": "^6.1.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.1",
    "googleapis": "^173.0.0",
    "imapflow": "^1.6.3",
    "node-cron": "^4.6.0",
    "openai": "^6.48.0",
    "pino": "^10.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.1.0",
    "tsx": "^4.23.6",
    "typescript": "^7.0.2"
  }
}
