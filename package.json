{
  "name": "inbox-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "test": "tsx --test 'src/**/*.test.ts'",
    "start": "node dist/main.js",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
    "imapflow": "^1.4.2",
    "node-cron": "^4.4.1",
    "openai": "^6.44.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
